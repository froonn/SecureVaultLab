# Окружение: prod отключает /docs и /openapi.json. Для локальной разработки — dev.
APP_ENV=prod
SESSION_TTL_MINUTES=60
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
DATABASE_URL=sqlite:////data/app.db
# Fernet-ключ подаётся через Docker secret (см. docker-compose.yml), а не через .env.
FERNET_KEY_FILE=/run/secrets/fernet_key
LOG_LEVEL=INFO
